generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model Organization {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String        @unique(map: "organizations_user_unique") @db.Uuid
  name              String
  mission_statement String
  description       String?
  contact_name      String
  contact_email     String
  contact_phone     String?
  website_url       String?
  address_line1     String?
  address_line2     String?
  city              String?
  state             String?
  zip_code          String?
  is_approved       Boolean       @default(false)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  opportunities     Opportunity[]
  profile           Profile       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([city, state], map: "idx_organizations_city_state")
  @@index([is_approved], map: "idx_organizations_is_approved")
  @@index([user_id], map: "idx_organizations_user_id")
  @@map("organizations")
  @@schema("public")
}

model Opportunity {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String                @db.Uuid
  created_by          String                @db.Uuid
  title               String
  description         String
  location_name       String?
  address_line1       String?
  address_line2       String?
  city                String?
  state               String?
  zip_code            String?
  start_at            DateTime              @db.Timestamptz(6)
  end_at              DateTime              @db.Timestamptz(6)
  capacity            Int
  minimum_age         Int?
  accessibility_notes String?
  requirements        String?
  status              opportunity_status    @default(draft)
  is_virtual          Boolean               @default(false)
  is_deleted          Boolean               @default(false)
  published_at        DateTime?             @db.Timestamptz(6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  approval_status     public_ApprovalStatus @default(pending)
  bookings            Booking[]
  messages            messages[]
  notification_logs   notification_logs[]
  notifications       Notification[]
  profiles            Profile               @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  organization        Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  opportunity_causes  opportunity_causes[]
  opportunity_skills  opportunity_skills[]
  volunteer_hours     volunteer_hours[]

  @@index([city, state], map: "idx_opportunities_city_state")
  @@index([created_by], map: "idx_opportunities_created_by")
  @@index([organization_id], map: "idx_opportunities_organization_id")
  @@index([start_at], map: "idx_opportunities_start_at")
  @@index([status, is_deleted], map: "idx_opportunities_status_deleted")
  @@map("opportunities")
  @@schema("public")
}

model Booking {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunity_id     String              @db.Uuid
  volunteer_id       String              @db.Uuid
  status             BookingStatus       @default(booked)
  notes              String?
  booked_at          DateTime            @default(now()) @db.Timestamptz(6)
  cancelled_at       DateTime?           @db.Timestamptz(6)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  attendanceLog      AttendanceLog?
  attendance_records attendance_records?
  opportunity        Opportunity         @relation(fields: [opportunity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  volunteer          Profile             @relation(fields: [volunteer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notification_logs  notification_logs[]
  notifications      Notification[]

  @@unique([opportunity_id, volunteer_id], map: "idx_bookings_unique_active", where: raw("(status = ANY (ARRAY['booked'::booking_status, 'waitlisted'::booking_status]))"))
  @@index([booked_at], map: "idx_bookings_booked_at")
  @@index([opportunity_id], map: "idx_bookings_opportunity_id")
  @@index([status], map: "idx_bookings_status")
  @@index([volunteer_id], map: "idx_bookings_volunteer_id")
  @@map("bookings")
  @@schema("public")
}

model Notification {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_id   String             @db.Uuid
  booking_id     String?            @db.Uuid
  opportunity_id String?            @db.Uuid
  type           String
  title          String
  message        String
  read_at        DateTime?          @db.Timestamptz(6)
  created_at     DateTime           @default(now()) @db.Timestamptz(6)
  sender_id      String?            @db.Uuid
  status         NotificationStatus @default(sent)
  archived_at    DateTime?          @db.Timestamptz(6)
  booking        Booking?           @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  opportunity    Opportunity?       @relation(fields: [opportunity_id], references: [id], onUpdate: NoAction)
  recipient      Profile            @relation("NotificationsReceived", fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender         Profile?           @relation("NotificationsSent", fields: [sender_id], references: [id], onUpdate: NoAction)

  @@index([recipient_id, read_at])
  @@index([sender_id, status])
  @@index([created_at])
  @@index([archived_at])
  @@map("notifications")
  @@schema("public")
}

model AttendanceLog {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id   String           @unique @db.Uuid
  recorded_by  String?          @db.Uuid
  status       AttendanceStatus
  notes        String?
  recorded_at  DateTime         @default(now()) @db.Timestamptz(6)
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  updated_at   DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  check_in_at  DateTime?        @db.Timestamptz(6)
  check_out_at DateTime?        @db.Timestamptz(6)
  booking      Booking          @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recorder     Profile?         @relation("AttendanceRecordedBy", fields: [recorded_by], references: [id], onUpdate: NoAction)

  @@index([recorded_by])
  @@map("attendance_logs")
  @@schema("public")
}

model Profile {
  id                                                     String               @id @default(uuid()) @db.Uuid
  role                                                   user_role            @default(volunteer)
  firstName                                              String?              @map("first_name")
  lastName                                               String?              @map("last_name")
  displayName                                            String?              @map("display_name")
  phone                                                  String?
  city                                                   String?
  state                                                  String?
  zipCode                                                String?              @map("zip_code")
  bio                                                    String?
  availabilityNotes                                      String?              @map("availability_notes")
  approvalStatus                                         ApprovalStatus       @default(approved) @map("approval_status")
  isActive                                               Boolean              @default(true) @map("is_active")
  createdAt                                              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                              DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  skillsAndCauses                                        String?
  expo_push_token                                        String?
  new_opportunity_notifications                          Boolean              @default(true)
  attendanceLogs                                         AttendanceLog[]      @relation("AttendanceRecordedBy")
  attendance_records                                     attendance_records[]
  audit_logs                                             audit_logs[]
  bookings                                               Booking[]
  messages_messages_recipient_idToprofiles               messages[]           @relation("messages_recipient_idToprofiles")
  messages_messages_sender_idToprofiles                  messages[]           @relation("messages_sender_idToprofiles")
  notification_logs                                      notification_logs[]
  receivedNotifications                                  Notification[]       @relation("NotificationsReceived")
  sentNotifications                                      Notification[]       @relation("NotificationsSent")
  opportunities                                          Opportunity[]
  organization                                           Organization?
  users                                                  users                @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_causes                                            user_causes[]
  user_skills                                            user_skills[]
  volunteer_hours_volunteer_hours_recorded_byToprofiles  volunteer_hours[]    @relation("volunteer_hours_recorded_byToprofiles")
  volunteer_hours_volunteer_hours_volunteer_idToprofiles volunteer_hours[]    @relation("volunteer_hours_volunteer_idToprofiles")

  @@index([isActive], map: "idx_profiles_is_active")
  @@index([role], map: "idx_profiles_role")
  @@map("profiles")
  @@schema("public")
}

